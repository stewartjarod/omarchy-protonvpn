#!/usr/bin/env bash
# ============================================================================
#  /usr/local/bin/qbittorrent - keeps qBittorrent inside the torrent tunnel.
#
#  /usr/local/bin comes before /usr/bin in PATH, so `qbittorrent` from a
#  terminal, the app launcher, or a magnet link lands here:
#    * already inside the tunnel's namespace -> run the real binary
#    * outside it                            -> relaunch inside via sudo
#    * tunnel not running                    -> refuse, with an explanation
#  To deliberately bypass it, run /usr/bin/qbittorrent.
# ============================================================================
set -uo pipefail
. /usr/local/lib/pvpn-torrent/common.sh
REAL="/usr/bin/qbittorrent"

# Same namespace inode as the tunnel's = already inside. Kernel ground truth.
in_tunnel() {
  local mine theirs
  mine=$(stat -Lc '%i' /proc/self/ns/net 2>/dev/null) || return 1
  theirs=$(stat -Lc '%i' "/run/netns/$NS" 2>/dev/null) || return 1
  [[ -n "$mine" && "$mine" == "$theirs" ]]
}

in_tunnel && exec "$REAL" "$@"

# qBittorrent is single-instance: a new launch just hands its arguments to the
# running copy and exits. If that copy is outside the tunnel (real connection)
# or in an old namespace (no network), quit it first so the new one, inside
# the tunnel, is the one that stays.
replace_stray_instance() {
  local ns pid pns strays=()
  ns=$(stat -Lc '%i' "/run/netns/$NS" 2>/dev/null) || return 0
  for pid in $(pgrep -u "$(id -u)" -x qbittorrent); do
    pns=$(stat -Lc '%i' "/proc/$pid/ns/net" 2>/dev/null) || continue
    [[ "$pns" != "$ns" ]] && strays+=("$pid")
  done
  (( ${#strays[@]} )) || return 0
  echo "qbittorrent: quitting the copy running outside the tunnel..." >&2
  kill -TERM "${strays[@]}" 2>/dev/null
  for _ in $(seq 1 60); do
    local alive=0
    for pid in "${strays[@]}"; do kill -0 "$pid" 2>/dev/null && alive=1; done
    (( alive )) || return 0
    sleep 0.5
  done
  echo "qbittorrent: it did not quit in 30s; not starting a second copy." >&2
  exit 1
}

# The namespace outlives the tunnel, so check the live status the port-forward
# loop publishes (up=1 only while the tunnel interface exists).
if ! ns_exists || ! grep -qx 'up=1' "$RUN_DIR/status" 2>/dev/null; then
  msg="qBittorrent was NOT started: the torrent tunnel is not running.
Start it from the Proton VPN panel, or: sudo systemctl start pvpn-torrent.service"
  echo "$msg" >&2
  command -v notify-send >/dev/null && notify-send --app-name="Proton VPN" --urgency=critical "qBittorrent not started" "The torrent tunnel is not running." 2>/dev/null
  exit 1
fi

replace_stray_instance
exec sudo -n /usr/local/bin/pvpn-torrent-launch "$@"
