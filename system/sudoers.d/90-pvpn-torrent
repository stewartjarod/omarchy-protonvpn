# Proton VPN torrent tunnel: what the desktop user may run without a password.
# Installed by system/install.sh after `visudo -c` validation.
#
#  * pvpn-torrent-launch starts the hardcoded /usr/bin/qbittorrent inside the
#    tunnel and drops to @USER@ before exec (arguments only reach that process).
#  * start/stop/restart of the tunnel unit, for the bar panel's toggle.
Defaults!/usr/local/bin/pvpn-torrent-launch env_keep += "WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE QT_QPA_PLATFORMTHEME QT_STYLE_OVERRIDE XCURSOR_THEME XCURSOR_SIZE GTK_THEME HYPRLAND_INSTANCE_SIGNATURE"
@USER@ ALL=(root) NOPASSWD: /usr/local/bin/pvpn-torrent-launch
@USER@ ALL=(root) NOPASSWD: /usr/bin/systemctl start pvpn-torrent.service, /usr/bin/systemctl stop pvpn-torrent.service, /usr/bin/systemctl restart pvpn-torrent.service
